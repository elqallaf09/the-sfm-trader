# Optional market data provider.
# Default is Yahoo Finance fallback.
DATA_PROVIDER=yahoo

# Required in production. JSON maps private bearer tokens (minimum 24 chars) to stable user IDs.
# Generate unique random tokens and store this value as a secret, never in Git.
# SFM_AUTH_TOKENS={"replace-with-a-long-random-token":"user-1"}
SFM_ALLOWED_ORIGINS=https://trader.the-sfm.com
SFM_RATE_LIMIT_MAX=120
SFM_ANALYSIS_RATE_LIMIT_MAX=30
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
SFM_TRUST_PROXY=false
SFM_DATA_DIR=.data
SFM_STORAGE_DRIVER=file
# Production database option:
# DATABASE_URL=postgresql://user:password@host:5432/the_sfm_trader
SFM_DB_SSL_MODE=require
SFM_DB_POOL_MAX=10
SFM_DB_CONNECT_TIMEOUT_MS=5000
SFM_REQUEST_TIMEOUT_MS=20000
SFM_HEADERS_TIMEOUT_MS=10000
SFM_KEEP_ALIVE_TIMEOUT_MS=5000
SFM_MAX_REQUESTS_PER_SOCKET=1000
SFM_MARKET_CACHE_MAX_ENTRIES=250
SFM_SHARIA_CACHE_MAX_ENTRIES=1000
PROVIDER_CACHE_MAX_ENTRIES=250
PROVIDER_CACHE_TTL_MS=45000
PROVIDER_REQUEST_TIMEOUT_MS=3500
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_MAX_CONCURRENT=3
PROVIDER_MIN_START_GAP_MS=240
SFM_ACCESS_LOG=false

# Enable Finnhub daily candles for plain US tickers:
# DATA_PROVIDER=finnhub
# FINNHUB_API_KEY=put_your_key_here

# Enable Twelve Data multi-asset candles for stocks, forex, and crypto:
# DATA_PROVIDER=twelvedata
# TWELVE_DATA_API_KEY=put_your_key_here

# Enable Alpha Vantage daily time series for plain US tickers:
# DATA_PROVIDER=alphavantage
# ALPHA_VANTAGE_API_KEY=put_your_key_here

# Optional external sharia screening endpoint. If empty, THE-SFM uses local labels.
# SHARIA_API_URL=
# SHARIA_API_KEY=

# Optional local AI brain for voice commands.
# Install Ollama, then pull the model:
# ollama pull llama3.2:3b
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
