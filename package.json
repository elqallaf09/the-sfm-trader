{
  "name": "the-sfm-trader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "check": "node tools/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/production.integration.mjs",
    "verify": "npm run check && npm test && npm run test:integration",
    "smoke": "node tools/smoke.mjs",
    "ios:add": "npx cap add ios",
    "ios:set-url": "node tools/set-ios-server-url.mjs",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:doctor": "npx cap doctor ios"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1"
  }
}
