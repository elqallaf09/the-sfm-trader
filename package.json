{
  "name": "the-sfm-trader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "check": "node tools/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/production.integration.mjs",
    "test:postgres": "node tests/postgres.integration.mjs",
    "test:a11y": "node --test tests/accessibility.test.mjs",
    "audit:css": "node tools/css-audit.mjs",
    "prune:css": "node tools/prune-dead-css.mjs",
    "verify": "npm run check && npm test && npm run test:a11y && npm run test:integration && npm run test:postgres",
    "smoke": "node tools/smoke.mjs",
    "ios:add": "npx cap add ios",
    "ios:set-url": "node tools/set-ios-server-url.mjs",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:doctor": "npx cap doctor ios"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
